{
  "openapi": "3.0.3",
  "info": {
    "title": "Golang Technical Test",
    "description": "Golang Technical Test API Specification",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "Users"
    },
    {
      "name": "Contacts"
    },
    {
      "name": "Addresses"
    },
    {
      "name": "Contact Limits"
    },
    {
      "name": "Transactions"
    }
  ],
  "components": {
    "securitySchemes": {
      "AuthToken": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization"
      }
    },
    "schemas": {
      "PageMetadata": {
        "type": "object",
        "properties": {
          "page": { "type": "integer" },
          "size": { "type": "integer" },
          "total_item": { "type": "integer", "format": "int64" },
          "total_page": { "type": "integer", "format": "int64" }
        }
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "username": { "type": "string" },
          "name": { "type": "string" },
          "token": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "UserTokenResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string" }
        }
      },
      "ContactResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "nik": { "type": "string" },
          "full_name": { "type": "string" },
          "legal_name": { "type": "string" },
          "birth_place": { "type": "string" },
          "birth_date": { "type": "string" },
          "salary": { "type": "integer", "format": "int64" },
          "ktp_photo": { "type": "string" },
          "selfie_photo": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "addresses": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AddressResponse" }
          }
        }
      },
      "AddressResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "street": { "type": "string" },
          "city": { "type": "string" },
          "province": { "type": "string" },
          "postal_code": { "type": "string" },
          "country": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "ContactLimitResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "tenor": { "type": "integer" },
          "limit_amount": { "type": "integer", "format": "int64" },
          "used_amount": { "type": "integer", "format": "int64" },
          "remaining_amount": { "type": "integer", "format": "int64" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "TransactionResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "contract_number": { "type": "string" },
          "tenor": { "type": "integer" },
          "channel": { "type": "string" },
          "otr": { "type": "integer", "format": "int64" },
          "admin_fee": { "type": "integer", "format": "int64" },
          "installment_amount": { "type": "integer", "format": "int64" },
          "interest_amount": { "type": "integer", "format": "int64" },
          "asset_name": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "RegisterUserRequest": {
        "type": "object",
        "required": ["username", "password", "name"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string" },
          "name": { "type": "string" }
        }
      },
      "LoginUserRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string" }
        }
      },
      "UpdateUserRequest": {
        "type": "object",
        "properties": {
          "password": { "type": "string" },
          "name": { "type": "string" }
        }
      },
      "CreateContactRequest": {
        "type": "object",
        "required": ["nik", "full_name", "legal_name", "birth_place", "birth_date", "salary", "ktp_photo", "selfie_photo"],
        "properties": {
          "nik": { "type": "string" },
          "full_name": { "type": "string" },
          "legal_name": { "type": "string" },
          "birth_place": { "type": "string" },
          "birth_date": { "type": "string" },
          "salary": { "type": "integer", "format": "int64" },
          "ktp_photo": { "type": "string" },
          "selfie_photo": { "type": "string" }
        }
      },
      "UpdateContactRequest": {
        "type": "object",
        "required": ["nik", "full_name", "legal_name", "birth_place", "birth_date", "salary", "ktp_photo", "selfie_photo"],
        "properties": {
          "nik": { "type": "string" },
          "full_name": { "type": "string" },
          "legal_name": { "type": "string" },
          "birth_place": { "type": "string" },
          "birth_date": { "type": "string" },
          "salary": { "type": "integer", "format": "int64" },
          "ktp_photo": { "type": "string" },
          "selfie_photo": { "type": "string" }
        }
      },
      "CreateAddressRequest": {
        "type": "object",
        "properties": {
          "street": { "type": "string" },
          "city": { "type": "string" },
          "province": { "type": "string" },
          "postal_code": { "type": "string" },
          "country": { "type": "string" }
        }
      },
      "UpdateAddressRequest": {
        "type": "object",
        "properties": {
          "street": { "type": "string" },
          "city": { "type": "string" },
          "province": { "type": "string" },
          "postal_code": { "type": "string" },
          "country": { "type": "string" }
        }
      },
      "CreateContactLimitRequest": {
        "type": "object",
        "required": ["tenor", "limit_amount"],
        "properties": {
          "tenor": { "type": "integer", "enum": [1, 2, 3, 6] },
          "limit_amount": { "type": "integer", "format": "int64" }
        }
      },
      "UpdateContactLimitRequest": {
        "type": "object",
        "required": ["tenor", "limit_amount"],
        "properties": {
          "tenor": { "type": "integer", "enum": [1, 2, 3, 6] },
          "limit_amount": { "type": "integer", "format": "int64" }
        }
      },
      "CreateTransactionRequest": {
        "type": "object",
        "required": ["contract_number", "tenor", "channel", "otr", "admin_fee", "installment_amount", "interest_amount", "asset_name"],
        "properties": {
          "contract_number": { "type": "string" },
          "tenor": { "type": "integer", "enum": [1, 2, 3, 6] },
          "channel": { "type": "string" },
          "otr": { "type": "integer", "format": "int64" },
          "admin_fee": { "type": "integer", "format": "int64" },
          "installment_amount": { "type": "integer", "format": "int64" },
          "interest_amount": { "type": "integer", "format": "int64" },
          "asset_name": { "type": "string" }
        }
      },
      "UpdateTransactionRequest": {
        "type": "object",
        "required": ["contract_number", "tenor", "channel", "otr", "admin_fee", "installment_amount", "interest_amount", "asset_name"],
        "properties": {
          "contract_number": { "type": "string" },
          "tenor": { "type": "integer", "enum": [1, 2, 3, 6] },
          "channel": { "type": "string" },
          "otr": { "type": "integer", "format": "int64" },
          "admin_fee": { "type": "integer", "format": "int64" },
          "installment_amount": { "type": "integer", "format": "int64" },
          "interest_amount": { "type": "integer", "format": "int64" },
          "asset_name": { "type": "string" }
        }
      },
      "WebResponseUser": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/UserResponse" },
          "errors": { "type": "string" }
        }
      },
      "WebResponseUserToken": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/UserTokenResponse" },
          "errors": { "type": "string" }
        }
      },
      "WebResponseContact": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/ContactResponse" },
          "errors": { "type": "string" }
        }
      },
      "WebResponseContactList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ContactResponse" }
          },
          "paging": { "$ref": "#/components/schemas/PageMetadata" },
          "errors": { "type": "string" }
        }
      },
      "WebResponseAddress": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/AddressResponse" },
          "errors": { "type": "string" }
        }
      },
      "WebResponseAddressList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AddressResponse" }
          },
          "errors": { "type": "string" }
        }
      },
      "WebResponseContactLimit": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/ContactLimitResponse" },
          "errors": { "type": "string" }
        }
      },
      "WebResponseContactLimitList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ContactLimitResponse" }
          },
          "errors": { "type": "string" }
        }
      },
      "WebResponseTransaction": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/TransactionResponse" },
          "errors": { "type": "string" }
        }
      },
      "WebResponseTransactionList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TransactionResponse" }
          },
          "errors": { "type": "string" }
        }
      },
      "WebResponseBool": {
        "type": "object",
        "properties": {
          "data": { "type": "boolean" },
          "errors": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/api/users": {
      "post": {
        "tags": ["Users"],
        "summary": "Register user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterUserRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WebResponseUser" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Logout user",
        "security": [{ "AuthToken": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WebResponseBool" }
              }
            }
          }
        }
      }
    },
    "/api/users/_login": {
      "post": {
        "tags": ["Users"],
        "summary": "Login user",
